# Sourced by bin/companion, bin/hub-watch and bin/presence (not run on its own).
# Loads this folder's hub.env (written by /bebop:setup): KEY=VALUE lines for HUB_HOME,
# HUB_URL and HUB_TOKEN_FILE. Read line by line, never `source`d, so a value may hold
# spaces, with or without quotes. Blank lines and # comments are skipped.
() {
  setopt localoptions extendedglob
  local f=${1:A:h:h}/hub.env line k v
  [[ -f $f ]] || return 0
  export HUB_ENV_FILE=$f   # so the scripts know hub.env is in charge: no defaults then
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == [A-Za-z_]*=* ]] || continue
    k=${line%%=*}; v=${line#*=}
    v=${v%%[[:space:]]##\#*}                       # a trailing " # comment"
    v=${v##[[:space:]]#}; v=${v%%[[:space:]]#}     # surrounding spaces
    if [[ $v == \"*\" || $v == \'*\' ]]; then v=${v[2,-2]}; fi
    export "$k=$v"
  done < $f
} ${(%):-%x}

# With a hub.env, every setting must come from it: a missing one is an error, never a default.
# hub_settings_ok prints what's missing and returns 1.
hub_settings_ok() {
  [[ -n ${HUB_ENV_FILE-} ]] || return 0
  local k missing=()
  for k in HUB_HOME HUB_URL HUB_TOKEN_FILE; do [[ -n ${(P)k-} ]] || missing+=($k); done
  (( ${#missing} )) || return 0
  print -u2 "hub.env ($HUB_ENV_FILE) doesn't set: ${missing[*]}. Add them (KEY=\"value\" lines); see /bebop:setup step 8."
  return 1
}
