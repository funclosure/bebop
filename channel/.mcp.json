{
  "mcpServers": {
    "hub": {
      "command": "bun",
      "args": ["run", "--cwd", "${CLAUDE_PLUGIN_ROOT}", "--shell=bun", "--silent", "start"],
      "env": {
        "MCP_PROTOCOL_NEGOTIATION": "legacy",
        "HUB_URL": "${HUB_URL:-http://127.0.0.1:8787}",
        "HUB_TOKEN_FILE": "${HUB_TOKEN_FILE:-}"
      }
    }
  }
}
